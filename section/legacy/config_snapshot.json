  "sectionsMetadata": {
    "adotta-un-progetto": {
      "description": {
        "it": "La vetrina digitale dove i Club possono condividere progetti da finanziare\no sostenere operativamente.",
        "en": "The digital showcase where Clubs can share projects to fund\nor support operationally."
      },
      "heroGradient": "from-emerald-600 to-emerald-700",
      "heroTag": {
        "it": "fiera digitale",
        "en": "digital fair"
      },
      "primaryColor": "#009739",
      "contentItemName": {
        "it": "progetti",
        "en": "projects"
      },
      "contentItemNameSingular": {
        "it": "progetto",
        "en": "project"
      },
      "explained": true,
      "explanation_title": {
        "it": "Come funziona",
        "en": "How it works"
      },
      "explanation_description": {
        "it": "Scopri e sostieni i progetti degli utenti di Radici Rotariane nel mondo. Contribuisci anche tu a fare la differenza",
        "en": "Discover and support projects from Radici Rotariane users around the world. Contribute to making a difference."
      },
      "explanation": [
        {
          "icon": "Compass",
          "title": {
            "it": "Esplora",
            "en": "Explore"
          },
          "description": {
            "it": "Scopri i progetti che chiedono il tuo aiuto",
            "en": "Discover the projects that need your help"
          }
        },
        {
          "icon": "Target",
          "title": {
            "it": "Scegli",
            "en": "Choose"
          },
          "description": {
            "it": "Seleziona il progetto che più ti sta a cuore",
            "en": "Select the project closest to your heart"
          }
        },
        {
          "icon": "Heart",
          "title": {
            "it": "Sostieni",
            "en": "Support"
          },
          "description": {
            "it": "Contribuisci con una donazione o supporto operativo",
            "en": "Contribute with a donation or operational support"
          }
        },
        {
          "icon": "Bookmark",
          "title": {
            "it": "Salva",
            "en": "Save"
          },
          "description": {
            "it": "Salva il progetto nel tuo profilo per mostrare il tuo interesse",
            "en": "Add the project to your profile to show your interest"
          }
        }
      ]
    },
    "storie-e-radici": {
      "description": {
        "it": "L'archivio multimediale dedicato alla cultura calabrese: racconti autentici che intrecciano memoria, identità e appartenenza.",
        "en": "The multimedia archive dedicated to Calabrian culture: authentic stories that weave together memory, identity and belonging."
      },
      "heroGradient": "from-blue-500 to-blue-600",
      "heroTag": {
        "it": "Identità Calabrese",
        "en": "Calabrian Identity"
      },
      "primaryColor": "#00a2e0",
      "explained": true,
      "explanation_title": {
        "it": "Condividi la tua storia",
        "en": "Share your story"
      },
      "explanation_description": {
        "it": "Condividi foto, video e documenti relativi ad esperienze personali, viaggi alle origini, storie di rotariani nel mondo e tradizioni calabresi.",
        "en": "Share photos, videos and documents related to personal experiences, journeys to your roots, stories of Rotarians around the world and Calabrian traditions."
      },
      "explanation": [
        {
          "icon": "Globe",
          "title": {
            "it": "Foto e Video",
            "en": "Photos and Videos"
          },
          "description": {
            "it": "Condividi foto e video di esperienze autentiche",
            "en": "Share photos and videos of authentic experiences"
          }
        },
        {
          "icon": "Flag",
          "title": {
            "it": "Racconti",
            "en": "Stories"
          },
          "description": {
            "it": "Racconta storie di rotariani di successo nel mondo",
            "en": "Tell stories of successful Rotarians around the world"
          }
        },
        {
          "icon": "Award",
          "title": {
            "it": "Tradizioni",
            "en": "Traditions"
          },
          "description": {
            "it": "Condividi aneddoti, ricette, tradizioni calabresi",
            "en": "Share anecdotes, recipes, Calabrian traditions"
          }
        }
      ]
    },
    "eccellenze-calabresi": {
      "description": {
        "it": "Scopri le migliori attività calabresi a prezzi agevolati: Ristoranti, hotel, aziende e professionisti di qualità, con sconti dedicati ai Rotariani in visita in Calabria.",
        "en": "Discover the best Calabrian businesses at reduced prices: Restaurants, hotels, companies and quality professionals, with discounts dedicated to Rotarians visiting Calabria."
      },
      "heroGradient": "from-[#f7a81b] to-[#e59710]",
      "heroTag": {
        "it": "Convenzioni e sconti",
        "en": "Benefits and Discounts"
      },
      "primaryColor": "#00adbb",
      "explained": true,
      "explanation_title": {
        "it": "Vuoi aderire?",
        "en": "Want to join?"
      },
      "explanation_description": {
        "it": "Hai un'attività o conosci un'attività che vorrebbe aderire al progetto offrendo sconti esclusivi ai rotariani in visita in Calabria? Contattaci",
        "en": "Do you have a business or know a business that would like to join the project by offering exclusive discounts to Rotarians visiting Calabria? Contact us"
      },
      "explanation": [],
      "explanation_contactEmail": "info@rotary2102.org"
    },
    "calendario-delle-radici": {
      "description": {
        "it": "Lo spazio dove puoi tenerti aggiornato e promuovere gli incontri rotariani di Club, Distrettuali ed internazionali (meeting, conferenze, service).",
        "en": "The space where you can stay updated and promote Rotary meetings at Club, District and international levels (meetings, conferences, service)."
      },
      "heroGradient": "from-blue-500 to-blue-600",
      "heroTag": {
        "it": "eventi",
        "en": "events"
      },
      "primaryColor": "#ff7600",
      "contentItemName": {
        "it": "eventi",
        "en": "events"
      },
      "contentItemNameSingular": {
        "it": "evento",
        "en": "event"
      }
    },
    "scopri-la-calabria": {
      "description": {
        "it": "La guida completa alla scoperta delle meraviglie del territorio calabrese: Mare cristallino, montagne maestose, storia millenaria e sapori autentici.",
        "en": "The complete guide to discovering the wonders of Calabrian territory: Crystal clear sea, majestic mountains, millenary history and authentic flavors."
      },
      "heroGradient": "from-rose-600 to-rose-700",
      "heroTag": {
        "it": "Turismo delle Radici",
        "en": "Heritage Tourism"
      },
      "primaryColor": "#d41367"
    },
    "scambi-e-mobilita": {
      "description": {
        "it": "La rete di ospitalità rotariana: una bacheca dove offrire o ricercare ospitalità, favorendo incontri, soggiorni, e visite tra Club nel segno dello Scambio d'amicizia Rotariana",
        "en": "The Rotary hospitality network: a bulletin board to offer or search for hospitality, promoting meetings, stays, and visits between Clubs in the spirit of the Rotary Friendship Exchange"
      },
      "heroGradient": "from-emerald-600 to-emerald-700",
      "heroTag": {
        "it": "Scambio d'Amicizia Rotariana",
        "en": "Rotary Friendship Exchange"
      },
      "primaryColor": "#7a6e66"
    },
    "archivio": {
      "description": {
        "it": "Un tuffo nel passato: documenti, testimonianze e immagini di eventi, scambi d'amicizia, gemellaggi e progetti già conclusi, per conservare e condividere i ricordi dei momenti più significativi.",
        "en": "A dive into the past: documents, testimonies and images of past events, friendship exchanges, twinning and completed projects, to preserve and share the memories of the most significant moments."
      },
      "heroGradient": "from-slate-600 to-slate-700",
      "heroTag": {
        "it": "Database Rotariano",
        "en": "Rotary Database"
      },
      "primaryColor": "#657f99"
    }
  },
