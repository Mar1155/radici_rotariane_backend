# =============================================================================
# Radici Rotariane — variabili d'ambiente
# =============================================================================
# Copia questo file in `.env` e riempi i valori. Le variabili non elencate qui
# hanno un default nel codice e si toccano solo per cambiare comportamento.
#
# Le sezioni marcate OBBLIGATORIO in produzione: senza, il deploy parte ma una
# parte della webapp non funziona. Quelle marcate FACOLTATIVO degradano in
# modo pulito se assenti.
# =============================================================================


# --- Django -----------------------------------------------------------------
# OBBLIGATORIO. Una stringa lunga e casuale, diversa per ogni ambiente.
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# In produzione resta False. Con True la webapp mostra i traceback a chiunque.
DEBUG=False

# OBBLIGATORIO in produzione: i domini da cui il backend accetta richieste.
# Separati da virgola, senza schema. '*' accetta tutto: non farlo.
ALLOWED_HOSTS=localhost,127.0.0.1

# OBBLIGATORIO dietro un proxy HTTPS (Railway, Render, nginx): gli origin
# ammessi per i form dell'admin. Con schema. Senza, il login a /cms/ da'
# "CSRF verification failed" e nessuno riesce a entrare nel pannello.
CSRF_TRUSTED_ORIGINS=https://api.esempio.it

# OBBLIGATORIO: l'origin del frontend, altrimenti il browser blocca ogni
# chiamata. Con schema, senza barra finale.
CORS_ALLOWED_ORIGINS=https://www.esempio.it


# --- Database ---------------------------------------------------------------
# OBBLIGATORIO. Su Railway la fornisce il servizio Postgres.
DATABASE_URL=postgres://utente:password@host:5432/nome_db


# --- Redis (chat e notifiche in tempo reale) --------------------------------
# OBBLIGATORIO se si vuole la chat: senza, i websocket non consegnano nulla.
# In alternativa a REDIS_URL si possono dare REDIS_HOST e REDIS_PORT.
REDIS_URL=redis://host:6379


# --- Indirizzi -------------------------------------------------------------
# OBBLIGATORIO: dove risponde questo backend. Wagtail lo usa per costruire gli
# indirizzi assoluti delle immagini; se sbagliato, le immagini non si vedono.
WAGTAILADMIN_BASE_URL=https://api.esempio.it

# OBBLIGATORIO: dove risponde il frontend. Serve a svuotargli la cache quando
# si pubblica una pagina dal CMS.
FRONTEND_BASE_URL=https://www.esempio.it

# OBBLIGATORIO insieme al precedente, e uguale a quello del frontend: se manca
# l'invalidazione non parte e le modifiche compaiono con un minuto di ritardo.
REVALIDATE_SECRET=


# --- Email ------------------------------------------------------------------
# OBBLIGATORIO. Senza, nessuno puo' registrarsi: la verifica dell'indirizzo
# passa da qui, e un utente che non riceve il codice non entra mai.
# Con Gmail serve una "password per le app", non quella dell'account.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Il mittente che vede il destinatario. Vuoto usa EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
# Dove scrivono gli utenti per assistenza. Vuoto usa EMAIL_HOST_USER.
SUPPORT_EMAIL=

# Solo per ambienti di prova: salta la verifica dell'indirizzo alla
# registrazione. In produzione deve restare False.
AUTO_VERIFY_EMAIL_ON_REGISTER=False


# --- Traduzione automatica --------------------------------------------------
# FACOLTATIVO ma consigliato. Senza chiave il sito funziona, ma i contenuti
# restano nella lingua in cui sono stati scritti e finiscono nella coda di
# revisione invece di essere tradotti.
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5
# Le lingue non stanno piu' qui: sono righe in `traduzione.Lingua`, e si
# aggiungono da /cms/ -> Struttura -> Lingue, senza deploy.


# --- Media sul bucket -------------------------------------------------------
# FACOLTATIVO. Senza, i file caricati restano sul disco del container e
# spariscono al primo riavvio: in produzione serve.
# Solo i media vanno sul bucket; gli statici li serve whitenoise dall'immagine.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-south-1

# Per uno storage S3-compatibile che non sia Amazon. Su Railway e' la
# variabile ENDPOINT del bucket. Lasciarlo vuoto significa AWS.
AWS_S3_ENDPOINT_URL=

# Un bucket privato (Railway) serve i file solo con URL firmati; uno pubblico
# (AWS con policy di lettura) li serve senza. Il default si regola da solo
# sulla presenza di AWS_S3_ENDPOINT_URL: si tocca solo per forzare.
# AWS_QUERYSTRING_AUTH=
# AWS_QUERYSTRING_EXPIRE=604800

# Se il bucket sta dietro una CDN o un dominio tuo.
AWS_S3_CUSTOM_DOMAIN=


# --- Tetti di spesa ---------------------------------------------------------
# Per persona e per ora. Non sono sicurezza — per quella ci sono i permessi —
# ma spesa: ogni contenuto scritto fa partire una traduzione a pagamento e
# ogni immagine occupa spazio. I valori sono larghi: chi usa la webapp
# normalmente non li sfiora. Si abbassano se qualcuno esagera.
# THROTTLE_SCRITTURA=120/hour
# THROTTLE_CARICAMENTO=60/hour
# THROTTLE_USER=2000/hour
# THROTTLE_ANON=300/hour


# --- Geocodifica ------------------------------------------------------------
# FACOLTATIVO: trasforma l'indirizzo di un club in coordinate per la mappa.
# Nominatim chiede un user agent che ti identifichi.
GEOCODING_ENABLED=True
GEOCODING_USER_AGENT=radici-rotariane/1.0 (contatto@esempio.it)


# --- Log --------------------------------------------------------------------
LOG_LEVEL=INFO
